# Backend API (server/) base URL
VITE_API_BASE_URL=http://localhost:5000

# CommitRegistry deployment
VITE_CONTRACT_ADDRESS=0xYourDeployedCommitRegistryAddress

# Chain the contract is deployed to (see contracts/cache/.../run-latest.json
# for the chain id you deployed to, e.g. 16602 for a local/dev chain)
VITE_CHAIN_ID=16602
VITE_CHAIN_NAME=VeilSwap Dev Chain
VITE_RPC_URL=http://127.0.0.1:8545
VITE_NATIVE_SYMBOL=ETH
# Optional — omit if you don't have a block explorer for this chain
VITE_EXPLORER_URL=

# WalletConnect Cloud project id, required by RainbowKit — get one free at
# https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=
